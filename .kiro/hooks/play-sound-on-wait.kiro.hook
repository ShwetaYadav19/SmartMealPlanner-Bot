{
  "enabled": true,
  "name": "Play Sound on Wait",
  "description": "Plays the macOS system sound when the agent stops and is waiting for user input, so you can hear it from across the room.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "afplay /System/Library/Sounds/Glass.aiff",
    "timeout": 5
  },
  "workspaceFolderName": "HOBBY_WORKSPACE",
  "shortName": "play-sound-on-wait"
}